# Shared LIBERO dataset transfer settings.
#
# Source this file from repo root:
#   source configs/libero_dataset_paths.env
#
# Training/eval scripts expect datasets at:
#   ${LIBERO_REPO_PATH}/libero/datasets/${LIBERO_DATASET_NAME}
#
# On the cluster, run from /users/anmari/vla-continual-learning and the
# default LIBERO_REPO_PATH below resolves to:
#   /users/anmari/vla-continual-learning/LIBERO

REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Canonical LIBERO repo used by examples/embodiment/run_embodiment.sh.
LIBERO_REPO_PATH="${LIBERO_REPO_PATH:-${REPO_ROOT}/LIBERO}"
LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-${LIBERO_REPO_PATH}}"

# Dataset currently used for OPD SFT teacher/debugging.
LIBERO_DATASET_NAME="${LIBERO_DATASET_NAME:-libero_spatial_256_from_rlds_reverted}"
LIBERO_DATASET_DIR="${LIBERO_DATASET_DIR:-${LIBERO_REPO_PATH}/libero/datasets/${LIBERO_DATASET_NAME}}"

# Hugging Face dataset repo to use for transfer. Set this before running:
#   export HF_DATASET_REPO_ID="antoniomari/libero-spatial-256-from-rlds-reverted"
HF_DATASET_REPO_ID="${HF_DATASET_REPO_ID:-}"
HF_REPO_TYPE="${HF_REPO_TYPE:-dataset}"

# Store the folder under this path inside the HF dataset repo.
HF_PATH_IN_REPO="${HF_PATH_IN_REPO:-${LIBERO_DATASET_NAME}}"

# Download staging area. The download script copies from this cache into LIBERO_DATASET_DIR.
HF_DATASET_STAGING_DIR="${HF_DATASET_STAGING_DIR:-${REPO_ROOT}/.cache/hf_datasets/${LIBERO_DATASET_NAME}}"
